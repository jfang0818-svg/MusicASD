[MAIN]
# Minimum Python version
py-version=3.11

# Ignore test files
ignore-patterns=test_.*\.py

[MESSAGES CONTROL]
# Disable non-critical warnings
disable=
    # Missing docstrings (style preference)
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring

    # Broad exception catching (intentional in API handlers)
    W0718,  # broad-exception-caught
    W0719,  # raising-bad-type

    # Protected access (needed for azure_storage._load_json pattern)
    W0212,  # protected-access

    # Unused arguments/variables (FastAPI Depends pattern)
    W0613,  # unused-argument
    W0612,  # unused-variable
    W0611,  # unused-import

    # Too many arguments/locals (complex but valid code)
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    R0917,  # too-many-positional-arguments
    R0912,  # too-many-branches
    R0915,  # too-many-statements

    # Too few public methods (Pydantic models)
    R0903,  # too-few-public-methods

    # Duplicate code (some repetition is acceptable)
    R0801,  # duplicate-code
    duplicate-code,  # alias for R0801

    # Import issues (handled by IDE/other tools)
    C0415,  # import-outside-toplevel
    C0411,  # wrong-import-order
    C0413,  # wrong-import-position
    E0401,  # import-error
    R0401,  # cyclic-import

    # Style preferences
    R1705,  # no-else-return
    R1731,  # consider-using-max-builtin
    R1730,  # consider-using-min-builtin
    W1309,  # f-string-without-interpolation
    C0103,  # invalid-name
    W0621,  # redefined-outer-name

    # Line length (handled by formatter)
    C0301,  # line-too-long

    # Missing final newline (handled by formatter)
    C0304,  # missing-final-newline

    # Bare except (sometimes intentional)
    W0702,  # bare-except

    # Logging format (project uses f-strings intentionally in some places)
    W1203,  # logging-fstring-interpolation

    # Raise without from (already fixed critical ones)
    W0707,  # raise-missing-from

    # Additional style/complexity warnings
    R0911,  # too-many-return-statements
    C0302,  # too-many-lines
    R0402,  # consider-using-from-import
    R0902,  # too-many-instance-attributes
    R0904,  # too-many-public-methods
    R1720,  # no-else-raise
    W0511,  # fixme (TODO comments)
    W1514,  # unspecified-encoding
    W0201,  # attribute-defined-outside-init
    W0603,  # global-statement
    W0404,  # reimported
    C0412,  # ungrouped-imports
    W0108,  # unnecessary-lambda

    # Temporarily disabled - need manual review
    E1120,  # no-value-for-parameter (some calls need user_id/child_id added)
    E0213,  # no-self-argument (Pydantic validators use cls)

[FORMAT]
# Maximum line length
max-line-length=100

[BASIC]
# Good variable names that are too short by default
good-names=i,j,k,e,ex,fs,id,db,ws,ts,ax,df

[DESIGN]
# Increase limits for complex modules
max-args=10
max-locals=25
max-branches=15

[TYPECHECK]
# Ignore missing members for dynamically loaded modules
ignored-modules=cv2,fluidsynth
ignored-classes=Wave_read,Wave_write,Synth

[IMPORTS]
# Allow known third-party packages
known-third-party=fastapi,pydantic,azure,numpy,scipy,pygame
