# ===================================
# musicASD Backend Configuration
# ===================================

# Environment
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Azure Blob Storage
# Get your connection string from Azure Portal → Storage Account → Access Keys
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_CONTAINER_NAME=musicasd-container
AZURE_USE_EMULATOR=false

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
GPT_MODEL=gpt-5.1
GPT_TEMPERATURE=0.7

# Security & Authentication
# IMPORTANT: Change these in production!
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Email Configuration (Zoho SMTP)
# Get your Zoho SMTP credentials from Zoho Mail settings
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your_zoho_email@yourdomain.com
SMTP_PASSWORD=your_zoho_email_password
FROM_EMAIL=your_zoho_email@yourdomain.com
FROM_NAME=musicASD

# Audio Configuration
AUDIO_SAMPLE_RATE=22050
AUDIO_BUFFER_SIZE=512
DEFAULT_VOLUME=0.7

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_SESSION_LOGS=1000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_MUSIC_GENERATION=true
ENABLE_FILE_UPLOAD=true
ENABLE_GPT_SUGGESTIONS=true
MCP_ENABLED=true
MEDIAPIPE_ENABLED=false

# CORS Configuration (for frontend)
EXTRA_ORIGINS=http://localhost:3000,http://localhost:3001

# File Size Limits
MAX_UPLOAD_SIZE=10485760
MAX_GENERATED_DURATION=30.0

# MediaPipe Configuration (for future camera integration)
POSE_DETECTION_CONFIDENCE=0.5

# Logging
LOG_LEVEL=INFO
